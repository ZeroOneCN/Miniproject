<UserControl x:Class="CameraMotionCapture.App.Views.CameraPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CameraMotionCapture.App.ViewModels"
             xmlns:conv="clr-namespace:CameraMotionCapture.App.Converters">
    <UserControl.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="6"
            Background="#1E1E1E"
            Margin="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（可双击切换全屏） ===== -->
            <Border Grid.Row="0"
                    Background="#2A2A2A"
                    Padding="8,4"
                    CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 录制指示灯 -->
                    <Ellipse Grid.Column="0"
                             Width="10" Height="10"
                             Fill="{Binding IsRecording, Converter={StaticResource BoolToColor}}"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center" />

                    <!-- 默认摄像头星标 -->
                    <TextBlock Grid.Column="1"
                               Text="★"
                               Foreground="{Binding IsDefaultCamera, Converter={StaticResource BoolToColor}}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Visibility="{Binding IsDefaultCamera, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 摄像头名称 -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding CameraName}"
                               Foreground="#DDD"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- 状态文本 + 人脸数 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="{Binding FaceCount, StringFormat=人脸: {0}}"
                                   Foreground="#66BB6A"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#AAA"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 预览区域（可缩放/平移/双击全屏） ===== -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <ScrollViewer x:Name="PreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#111">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Source="{Binding CameraImage}"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"
                               MouseWheel="PreviewImage_MouseWheel"
                               MouseDown="PreviewImage_MouseDown"
                               MouseMove="PreviewImage_MouseMove"
                               MouseUp="PreviewImage_MouseUp"
                               Cursor="Hand">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </ScrollViewer>

                <!-- 等待提示 -->
                <TextBlock Text="等待摄像头连接..."
                           Visibility="{Binding CameraImage, Converter={StaticResource NullToVisibility}}"
                           Foreground="#666"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />

                <!-- 运动检测指示 -->
                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="0,4,4,0"
                        Padding="6,2"
                        CornerRadius="3"
                        Background="#AA000000"
                        Visibility="{Binding MotionDetected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="运动!"
                               Foreground="#FF4444"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <!-- 缩放控制栏 -->
                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,4,4"
                        Padding="4"
                        CornerRadius="4"
                        Background="#AA222222">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−"
                                Style="{StaticResource ZoomButton}"
                                Command="{Binding ZoomOutCommand}"
                                ToolTip="缩小" />
                        <TextBlock Text="{Binding ZoomLevel, StringFormat={}{0:F1}x}"
                                   Foreground="#DDD"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="5,0" />
                        <Button Content="+"
                                Style="{StaticResource ZoomButton}"
                                Command="{Binding ZoomInCommand}"
                                ToolTip="放大" />
                        <Button Content="⟲"
                                Style="{StaticResource ZoomButton}"
                                Width="26" Height="26"
                                FontSize="14"
                                Margin="5,0,0,0"
                                Command="{Binding ZoomResetCommand}"
                                ToolTip="重置缩放" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 底部工具栏 ===== -->
            <Border Grid.Row="2"
                    Background="#2A2A2A"
                    Padding="8,4"
                    CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="开始监控"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource PanelButton}"
                            Background="#1E88E5" />
                    <Button Content="停止"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource PanelButton}"
                            Background="#F44336" />
                    <Button Content="抓拍"
                            Command="{Binding SnapshotCommand}"
                            Style="{StaticResource PanelButton}"
                            Background="#4CAF50" />
                    <Button Content="⛶ 放大"
                            Command="{Binding MaximizeCommand}"
                            Style="{StaticResource PanelButton}"
                            Background="#9C27B0"
                            Margin="5,0,0,0"
                            ToolTip="双击画面也可切换全屏" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>