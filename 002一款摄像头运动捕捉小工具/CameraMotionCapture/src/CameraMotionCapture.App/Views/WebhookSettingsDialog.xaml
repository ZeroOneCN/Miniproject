<Window x:Class="CameraMotionCapture.App.Views.WebhookSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="企业微信Webhook设置"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置企业微信机器人的Webhook地址，用于发送运动检测通知。"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Webhook URL:" />
            <TextBox x:Name="WebhookInput" Grid.Row="1"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="60" />
        </Grid>

        <Button Grid.Row="2" Content="测试连接" x:Name="TestButton"
                Click="TestButton_Click" Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" />

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存设置" x:Name="SaveButton"
                    Click="SaveButton_Click" Width="100"
                    Style="{StaticResource SuccessButton}" />
            <Button Content="取消" x:Name="CancelButton"
                    Click="CancelButton_Click" Width="80"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>