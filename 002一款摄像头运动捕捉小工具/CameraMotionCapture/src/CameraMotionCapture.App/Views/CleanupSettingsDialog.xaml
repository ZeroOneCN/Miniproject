<Window x:Class="CameraMotionCapture.App.Views.CleanupSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录像保留设置"
        Width="420" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="保留录像时长:" />
            <TextBox x:Name="RetentionDaysInput" Grid.Row="0" Grid.Column="1"
                     Margin="8,0,0,0" />

            <Label Grid.Row="1" Grid.Column="0" Content="下次清理日期:" Margin="0,8,0,0" />
            <DatePicker x:Name="CleanupDatePicker" Grid.Row="1" Grid.Column="1"
                        Margin="8,8,0,0" />
        </Grid>

        <Button Grid.Row="1" Content="立即清理过期文件" x:Name="CleanupNowButton"
                Click="CleanupNowButton_Click"
                HorizontalAlignment="Left"
                Style="{StaticResource DangerButton}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存设置" x:Name="SaveButton"
                    Click="SaveButton_Click" Width="100"
                    Style="{StaticResource SuccessButton}" />
            <Button Content="取消" x:Name="CancelButton"
                    Click="CancelButton_Click" Width="80"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>