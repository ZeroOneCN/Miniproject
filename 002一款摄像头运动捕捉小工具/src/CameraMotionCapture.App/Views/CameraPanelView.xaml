<UserControl x:Class="CameraMotionCapture.App.Views.CameraPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CameraMotionCapture.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvVis" />

        <!-- 录制胶囊：录制中红底白字并呼吸闪烁，监控未录制时是低调的灰胶囊 -->
        <Style x:Key="RecordChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Danger}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RecBlink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.55" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RecBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>

                <!-- 已布防：琥珀底，和"真的在录"的红底区分开 -->
                <DataTrigger Binding="{Binding RecordArmed}" Value="True">
                    <Setter Property="Background" Value="#D9B4761E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="PanelRoot" Margin="4" CornerRadius="8" Background="{StaticResource VideoBack}"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <!-- 录制中整块面板描红边：多路同时监控时，扫一眼就知道哪几路在录 -->
                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══════ 标题栏 ══════ -->
            <Border Grid.Row="0" Background="{StaticResource VideoChrome}" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态灯 -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding StatusBrush}" Margin="0,0,8,0" />

                    <TextBlock Grid.Column="1" Text="{Binding CameraName}"
                               Foreground="{StaticResource VideoText}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" />

                    <!-- 录制 / 监控状态胶囊 -->
                    <Border Grid.Column="2" Style="{StaticResource RecordChip}" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowRecordChip, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding RecordText}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTarget}" FontSize="11"
                                   Foreground="#7C838F" Margin="0,0,10,0" VerticalAlignment="Center" />

                        <Border Background="#2AF0F0F0" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"
                                Visibility="{Binding ShowFaceCount, Converter={StaticResource Vis}}">
                            <TextBlock FontSize="10.5" Foreground="#8BE08B">
                                <Run Text="人脸 " /><Run Text="{Binding FaceCount, Mode=OneWay}" />
                            </TextBlock>
                        </Border>

                        <TextBlock Text="{Binding Fps, StringFormat={}{0:F0} fps}" FontSize="11"
                                   Foreground="{Binding FpsBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" ToolTip="{Binding FpsToolTip}" />

                        <Button Content="⛶" Style="{StaticResource ChromeButton}" FontSize="13"
                                Command="{Binding FullscreenCommand}" ToolTip="铺满窗口（F11）" />
                        <Button Content="✕" Style="{StaticResource ChromeButton}"
                                Command="{Binding DataContext.RemoveCameraCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="移除此摄像头" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════ 画面 ══════ -->
            <!-- 不用 ScrollViewer：它给子元素的测量约束是无限大，Stretch 不会把画面缩到面板大小，
                 而是按原始像素尺寸溢出后被裁切。缩放/平移统一交给 RenderTransform，
                 Image 的宽高由 code-behind 按「适应 / 填满」等比算好；这里用 Uniform 而不是 Fill：
                 万一宽高因取整/延迟和源比例差了零点几像素，Uniform 只会让边缘多出半根发丝的空隙，
                 绝不会把画面拉变形。 -->
            <Grid x:Name="PreviewHost" Grid.Row="1" Background="{StaticResource VideoBack}" ClipToBounds="True"
                  SizeChanged="PreviewHost_SizeChanged"
                  MouseWheel="PreviewImage_MouseWheel"
                  MouseDown="PreviewImage_MouseDown"
                  MouseMove="PreviewImage_MouseMove"
                  MouseUp="PreviewImage_MouseUp"
                  MouseLeave="PreviewImage_MouseLeave">

                <!-- 画面 + 检测区域放在同一层：缩放/平移作用在整层上，区域框跟着画面一起走 -->
                <Grid x:Name="ImageLayer" HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Image x:Name="PreviewImage"
                           Source="{Binding CameraImage, NotifyOnTargetUpdated=True}"
                           TargetUpdated="PreviewImage_TargetUpdated"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- 检测区域：只在框内判定运动 -->
                    <Canvas x:Name="RegionLayer" IsHitTestVisible="False">
                        <Border x:Name="RegionBox" BorderBrush="{StaticResource Danger}" BorderThickness="2"
                                Background="#22E0524B" Visibility="Collapsed">
                            <TextBlock Text="检测区域" Foreground="#FFB4AE" FontSize="10"
                                       Margin="5,2" FontWeight="SemiBold" />
                        </Border>

                        <!-- 框选过程中的虚线预览框 -->
                        <Rectangle x:Name="RegionDraft" Stroke="#FFD79A" StrokeThickness="1.5"
                                   StrokeDashArray="4 3" Fill="#22E8A33D" Visibility="Collapsed" />
                    </Canvas>
                </Grid>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CameraImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding StatusText}" Foreground="#5C636E" FontSize="13"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 运动提示 -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Padding="10,3" CornerRadius="10" Background="#CCE0524B"
                        Visibility="{Binding MotionActive, Converter={StaticResource Vis}}">
                    <TextBlock Text="检测到运动" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- 框选提示 -->
                <Border VerticalAlignment="Top" Margin="0,10,0,0"
                        Padding="12,5" CornerRadius="10" Background="#D9E8A33D"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsSelectingRegion, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="按住左键拖拽，框出要检测的范围" Foreground="White"
                                   FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Text="· 再次点「完成框选」退出" Foreground="#FFF0D5"
                                   FontSize="11" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- 右上角录制角标：红点 + 计时，缩到小面板也看得见 -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0"
                        Padding="8,3" CornerRadius="10" Background="#E6C02020"
                        Visibility="{Binding IsRecording, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#FF5A52" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding RecordText}" Foreground="White" FontSize="10.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 停止遮罩：设备已关闭，画面是最后一帧，必须让人一眼看出来不是"卡了" -->
                <Border Background="#C412151B" IsHitTestVisible="False"
                        Visibility="{Binding IsStopped, Converter={StaticResource Vis}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsStopped, Converter={StaticResource Vis}}">
                    <TextBlock Text="已停止采集" FontSize="14" FontWeight="SemiBold"
                               Foreground="#EDEFF3" HorizontalAlignment="Center" />
                    <TextBlock Text="摄像头已释放 · 点下方「开始监控」重新连接"
                               FontSize="11.5" Foreground="#8A909B"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ══════ 底部操作条 ══════ -->
            <Border Grid.Row="2" Background="{StaticResource VideoChrome}" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="开始监控" Style="{StaticResource ChromeButton}"
                                Command="{Binding StartCommand}"
                                Visibility="{Binding IsMonitoring, Converter={StaticResource InvVis}}" />
                        <Button Content="停止监控" Style="{StaticResource ChromeButton}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsMonitoring, Converter={StaticResource Vis}}" />

                        <!-- 录像只认这一下点击：程序启动、开始监控都不会自己录 -->
                        <Button Content="{Binding RecordButtonText}" Style="{StaticResource ChromeButton}"
                                Command="{Binding ToggleRecordCommand}"
                                Foreground="{Binding RecordButtonBrush}"
                                FontWeight="SemiBold"
                                ToolTip="{Binding RecordButtonTip}" />

                        <TextBlock Text="·" Foreground="#4A4F58" VerticalAlignment="Center" Margin="2,0" />
                        <Button Content="抓拍" Style="{StaticResource ChromeButton}"
                                Command="{Binding SnapshotCommand}" />

                        <TextBlock Text="·" Foreground="#4A4F58" VerticalAlignment="Center" Margin="2,0" />
                        <Button Content="{Binding RegionButtonText}" Style="{StaticResource ChromeButton}"
                                Command="{Binding ToggleRegionModeCommand}"
                                ToolTip="{Binding RegionTip}" />
                        <Button Content="清除" Style="{StaticResource ChromeButton}"
                                Command="{Binding ClearRegionCommand}"
                                Visibility="{Binding HasRegion, Converter={StaticResource Vis}}"
                                ToolTip="恢复全画面检测" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                               Foreground="#7C838F" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource ChromeButton}"
                                Command="{Binding ZoomOutCommand}" ToolTip="缩小" />
                        <TextBlock Text="{Binding ZoomText}" FontSize="10.5" Foreground="#7C838F"
                                   VerticalAlignment="Center" Margin="2,0" MinWidth="30"
                                   TextAlignment="Center" />
                        <Button Content="+" Style="{StaticResource ChromeButton}"
                                Command="{Binding ZoomInCommand}" ToolTip="放大" />
                        <Button Content="⟲" Style="{StaticResource ChromeButton}"
                                Command="{Binding ZoomResetCommand}" ToolTip="重置缩放" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
