<Window x:Class="CameraMotionCapture.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        Icon="pack://application:,,,/Resources/app-icon.png"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="HintText" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,6,0,14" />

        <TextBox x:Name="Input" Height="34" VerticalContentAlignment="Center" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" Width="82" IsCancel="True" />
            <Button Content="确定" Style="{StaticResource AccentButton}" Width="82" Margin="10,0,0,0"
                    IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
