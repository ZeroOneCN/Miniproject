<Window x:Class="CameraMotionCapture.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CameraMotionCapture.App.Views"
        xmlns:conv="clr-namespace:CameraMotionCapture.App.Converters"
        Title="摄像头监控台"
        Icon="pack://application:,,,/Resources/app-icon.png"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="640"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Vis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvVis" />

        <!-- 顶栏录制胶囊：录制中红底并呼吸，未录制时是灰色低调提示 -->
        <Style x:Key="GlobalRecChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#F1F3F7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AnyRecording}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Danger}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="GlobalRecBlink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.6" Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="GlobalRecBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════ 顶部栏 ══════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/app-icon.png"
                           Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="摄像头监控台" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- 布局、画面选择与填充方式 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <ComboBox Width="124" SelectedIndex="{Binding LayoutIndex}" ToolTip="画面布局">
                        <ComboBoxItem Content="自动铺满" />
                        <ComboBoxItem Content="单画面" />
                        <ComboBoxItem Content="四画面" />
                        <ComboBoxItem Content="九画面" />
                    </ComboBox>

                    <ComboBox Width="160" Margin="8,0,0,0"
                              ItemsSource="{Binding Cameras}"
                              SelectedItem="{Binding SelectedCamera}"
                              DisplayMemberPath="CameraName"
                              Visibility="{Binding IsSingleLayout, Converter={StaticResource Vis}}"
                              ToolTip="单画面模式下显示哪一路" />

                    <!-- 填满 = 裁切不留黑边；适应 = 完整可见、可能留边 -->
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,7"
                            Command="{Binding ToggleFillCommand}"
                            ToolTip="切换「填满面板（可能有裁切）」与「等比适应（可能有黑边）」">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="画面" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FillModeText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右侧操作区 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 录制总览：一眼确认"到底在不在录" -->
                    <Border Style="{StaticResource GlobalRecChip}"
                            Visibility="{Binding HasMonitoring, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#9AA1AC" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnyRecording}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding RecordingChipText}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnyRecording}" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Content="全部开始" Style="{StaticResource AccentButton}"
                            Padding="16,7"
                            Command="{Binding StartAllCommand}" />
                    <Button Content="全部停止" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding StopAllCommand}" />

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSoft}" Margin="14,0" />

                    <Button Content="刷新设备" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="网络摄像头" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding AddIpCameraCommand}" />
                    <Button Content="保存目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding OpenSaveDirCommand}" />
                    <Button Content="设置" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding SettingsCommand}" />

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSoft}" Margin="14,0" />

                    <ToggleButton Content="事件" Style="{StaticResource GhostToggle}"
                                  IsChecked="{Binding IsEventBarVisible, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ 主内容 ══════════════════ -->
        <!-- 边距由 code-behind 按窗口状态调整：最大化时贴边铺满，普通窗口留呼吸空间 -->
        <Grid x:Name="ContentRoot" Grid.Row="1" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 画面网格 -->
            <Grid Grid.Column="0">
                <ItemsControl ItemsSource="{Binding VisibleCameras}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataContext.GridRows,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Columns="{Binding DataContext.GridColumns,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CameraPanelView
                                FillMode="{Binding DataContext.FillScreen,
                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border Background="{StaticResource Surface}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                        Visibility="{Binding HasCameras, Converter={StaticResource InvVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="◎" FontSize="40" Foreground="{StaticResource BorderStrong}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="还没有检测到摄像头" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="插上 USB 摄像头后点击「刷新设备」，或添加局域网网络摄像头"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                        <Button Content="刷新设备" Style="{StaticResource AccentButton}"
                                Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 事件栏（单路放大时自动让位） -->
            <Border Grid.Column="1" Width="248" Margin="10,0,0,0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding ShowEventBar, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="事件记录" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="清空" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Padding="8,3" FontSize="11.5"
                                    Command="{Binding ClearEventsCommand}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="EventList" ItemsSource="{Binding Events}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="EventList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="4,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceAlt}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding CameraName}" FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="12,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="暂无事件" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasEvents, Converter={StaticResource InvVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════ 状态栏 ══════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid Height="30">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AnyRecording}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LiveSummary}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="12" Fill="{StaticResource BorderSoft}" Margin="10,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MemoryText}" FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               ToolTip="程序自身占用（采集缓冲 + 解码 + 界面），不含系统其他进程" />
                    <Rectangle Width="1" Height="12" Fill="{StaticResource BorderSoft}" Margin="12,0" />
                    <TextBlock Text="{Binding DiskUsageText}" FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               ToolTip="录像与截图占用的磁盘空间 / 配置的容量上限" />
                    <Rectangle Width="1" Height="12" Fill="{StaticResource BorderSoft}" Margin="12,0" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}">
                        <Run Text="共" /><Run Text="{Binding Cameras.Count, Mode=OneWay}" /><Run Text=" 路" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
