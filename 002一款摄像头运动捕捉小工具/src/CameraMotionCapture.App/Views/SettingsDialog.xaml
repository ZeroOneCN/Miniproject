<Window x:Class="CameraMotionCapture.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="pack://application:,,,/Resources/app-icon.png"
        Width="580" Height="640"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <!-- ═══════ 采集 ═══════ -->
            <TabItem Header="采集">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <Label Content="采集后端" />
                        <ComboBox x:Name="BackendCombo">
                            <ComboBoxItem Content="自动（推荐）" />
                            <ComboBoxItem Content="DirectShow（兼容性最好·默认）" />
                            <ComboBoxItem Content="Media Foundation（部分 USB 摄像头帧率更高，但打开要慢几秒）" />
                            <ComboBoxItem Content="任意（由 OpenCV 自行决定）" />
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   Margin="2,4,2,0"
                                   Text="手机投屏、直播软件、会议软件会注册虚拟摄像头。程序会按系统注册信息识别并跳过这类设备，无论选哪个后端都不会去打开它们。" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   Margin="2,4,2,0"
                                   Text="实际帧率显示在每路画面标题栏（低于设定值会变黄）。若长期偏低：先看光线是否不足（暗光会自动拉长曝光），再考虑换后端或降分辨率。" />

                        <Label Content="分辨率" />
                        <ComboBox x:Name="ResolutionCombo">
                            <ComboBoxItem Content="1920 × 1080（全高清·默认）" />
                            <ComboBoxItem Content="1280 × 720（高清）" />
                            <ComboBoxItem Content="640 × 480（标清）" />
                            <ComboBoxItem Content="320 × 240（低带宽）" />
                        </ComboBox>

                        <Label Content="采集帧率（FPS）" />
                        <ComboBox x:Name="FpsCombo">
                            <ComboBoxItem Content="60（高帧率，带宽占用大）" />
                            <ComboBoxItem Content="30（默认）" />
                            <ComboBoxItem Content="25" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="15（省资源）" />
                            <ComboBoxItem Content="10" />
                        </ComboBox>

                        <CheckBox x:Name="HardwareAccelCheck" Content="启用硬件加速（部分驱动支持）"
                                  Margin="0,16,0,0" />

                        <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2A5FA8">
                                修改分辨率或帧率会重新初始化摄像头，画面会短暂中断。
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 录像 ═══════ -->
            <TabItem Header="录像">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <CheckBox x:Name="RecordEnabledCheck" Content="启用录像功能" FontWeight="SemiBold" />

                        <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#2A5FA8"
                                       Text="程序启动和「开始监控」都不会自动录像。开启本项只是让每路面板上的「● 录像」按钮可点，点了才开始写文件；停止监控或退出程序即停止。录像按摄像头原始分辨率写入，不做任何拉伸。" />
                        </Border>

                        <Label Content="录制模式" />
                        <ComboBox x:Name="RecordModeCombo">
                            <ComboBoxItem Content="一直录，直到手动停止" />
                            <ComboBoxItem Content="布防后仅运动时录（省空间）" />
                        </ComboBox>

                        <Label Content="保存目录" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveDirInput" Grid.Column="0" IsReadOnly="True" Height="34" />
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}"
                                    Height="34" Padding="14,0" Margin="8,0,0,0" Click="OnBrowseDirectory" />
                        </Grid>

                        <Label Content="编码格式" />
                        <ComboBox x:Name="CodecCombo">
                            <ComboBoxItem Content="MJPG（兼容性最好）" />
                            <ComboBoxItem Content="XVID" />
                            <ComboBoxItem Content="MP4V" />
                        </ComboBox>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="分段时长（分钟）" />
                                <TextBox x:Name="SegmentInput" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="单次事件录制（秒）" />
                                <TextBox x:Name="MotionRecordInput" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="容量上限（GB，0 为不限）" />
                                <TextBox x:Name="MaxStorageInput" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Label Content="保留天数" />
                                <TextBox x:Name="RetentionInput" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="DailyFolderCheck" Content="按日期分文件夹存放" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 检测 ═══════ -->
            <TabItem Header="检测">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <CheckBox x:Name="MotionEnabledCheck" Content="启用运动检测" FontWeight="SemiBold" />

                        <Label Content="灵敏度（数值越大越容易触发）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SensitivitySlider" Grid.Column="0" Minimum="1" Maximum="100" />
                            <TextBlock x:Name="SensitivityLabel" Grid.Column="1" Width="42"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <Label Content="告警冷却（秒，两次通知的最小间隔）" />
                        <TextBox x:Name="CooldownInput" />

                        <CheckBox x:Name="SnapshotOnMotionCheck" Content="检测到运动时自动截图" Margin="0,12,0,0" />

                        <Separator Margin="0,18,0,10" />

                        <CheckBox x:Name="FaceEnabledCheck" Content="启用人脸检测" FontWeight="SemiBold" />

                        <Label Content="级联模型文件" />
                        <TextBox x:Name="CascadeInput" IsReadOnly="True" />

                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,8,0,0">
                            人脸检测仅用于画面标注，不做身份识别。模型文件需与程序位于同一目录。
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 叠加 ═══════ -->
            <TabItem Header="叠加">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <TextBlock Text="在画面与截图中叠加的信息" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />

                        <CheckBox x:Name="OverlayTimestampCheck" Content="显示时间戳" />
                        <CheckBox x:Name="OverlayDeviceCheck" Content="显示设备名称" />

                        <Label Content="自定义水印（支持 {name} {time} {date} 占位符）" />
                        <TextBox x:Name="WatermarkInput" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 通知 ═══════ -->
            <TabItem Header="通知">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <TextBlock Text="企业微信群机器人 Webhook" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,10">
                            填写群机器人地址后，运动检测触发时会推送截图与文字提醒。留空则不推送。
                        </TextBlock>

                        <TextBox x:Name="WebhookInput" Height="34" VerticalContentAlignment="Center" />

                        <Button Content="发送测试消息" Style="{StaticResource GhostButton}"
                                Width="130" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OnTestWebhook" x:Name="TestButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}" Width="92" IsCancel="True" />
            <Button Content="保存设置" Style="{StaticResource AccentButton}" Width="110"
                    Margin="10,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
