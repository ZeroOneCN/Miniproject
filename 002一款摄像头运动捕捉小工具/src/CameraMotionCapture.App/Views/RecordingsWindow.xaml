<Window x:Class="CameraMotionCapture.App.Views.RecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录像库"
        Width="1150" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource AppBackground}">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════ 左：文件列表 ══════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,12,10,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="录像文件" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="ClipSummary" Text="正在读取…" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="刷新" Style="{StaticResource GhostButton}" Padding="10,4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="OnRefreshClick" />
                    </Grid>
                </Border>

                <ListBox x:Name="ClipList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnClipSelected">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="6,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                                           Margin="0,3,0,0">
                                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding TimeText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="12,10" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                    <Button Content="打开所在文件夹" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" FontSize="12" Padding="10,4"
                            Click="OnOpenFolderClick" />
                </Border>
            </Grid>
        </Border>

        <!-- ══════ 右：播放器 ══════ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{StaticResource VideoBack}">
                    <Image x:Name="PlayerImage" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="▤" FontSize="38" Foreground="#39404B" HorizontalAlignment="Center" />
                        <TextBlock Text="左侧选一段录像开始回放" FontSize="13" Foreground="#5C636E"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="PlaybackError" FontSize="12" Foreground="#E0524B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" Visibility="Collapsed" />
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="14,10"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="PlayButton" Content="▶ 播放" Style="{StaticResource GhostButton}"
                                    Width="88" Click="OnPlayClick" />
                            <Button Content="上一段" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Padding="10,6" FontSize="12" Click="OnPrevClick" />
                            <Button Content="下一段" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Padding="10,6" FontSize="12" Click="OnNextClick" />
                        </StackPanel>

                        <Slider x:Name="Progress" Grid.Column="1" Margin="16,0" IsSnapToTickEnabled="False"
                                TickFrequency="1" Thumb.DragStarted="OnSeekStart" Thumb.DragCompleted="OnSeekEnd"
                                ValueChanged="OnSeek" />

                        <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                   MinWidth="110" TextAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
