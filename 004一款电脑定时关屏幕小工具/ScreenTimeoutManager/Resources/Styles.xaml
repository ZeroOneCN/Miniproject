<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主窗口背景 -->
    <Style TargetType="Window" x:Key="MainWindowStyle">
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 标题样式 -->
    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,12,0,8" />
    </Style>

    <!-- 分组框 -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="12,6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#555555" />
    </Style>

    <!-- 状态标签 -->
    <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#444444" />
    </Style>

    <!-- 按钮样式 -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="80" />
    </Style>

    <!-- 提示文本 -->
    <Style x:Key="TipStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#888888" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

</ResourceDictionary>