<Window x:Class="PortMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PortMonitor"
        mc:Ignorable="d"
        Title="端口占用与进程管理 v1.0"
        Icon="app_icon.png"
        MinWidth="800" MinHeight="560"
        Width="860" Height="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="13"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:EmptyStringConverter x:Key="EmptyStringConverter" />

        <!-- 结束进程按钮样式 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B0B0B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通按钮样式 -->
        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8E8E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D0D0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Title ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Viewbox Width="24" Height="24" Margin="0,0,8,0">
                <Canvas Width="24" Height="24">
                    <!-- 网络端口 SVG 图标 -->
                    <Path Fill="#2C3E50" Data="M3,3 L21,3 L21,21 L3,21 Z" />
                    <Path Fill="#3498DB" Data="M5,5 L19,5 L19,9 L5,9 Z" />
                    <Path Fill="#ECF0F1" Data="M6,6 L11,6 L11,8 L6,8 Z" />
                    <Path Fill="#ECF0F1" Data="M13,6 L18,6 L18,8 L13,8 Z" />
                    <Path Fill="#2C3E50" Data="M5,11 L19,11 L19,19 L5,19 Z" />
                    <Path Fill="#E74C3C" Data="M7,13 L11,13 L11,17 L7,17 Z" />
                    <Path Fill="#2ECC71" Data="M13,13 L17,13 L17,15 L13,15 Z" />
                    <Path Fill="#2ECC71" Data="M13,16 L17,16 L17,18 L13,18 Z" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="端口占用与进程管理"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══ Query Frame ═══ -->
        <GroupBox Grid.Row="1" Header="端口查询" Padding="8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="端口号" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="PortTextBox"
                         Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Height="26" />

                <Label Grid.Column="2" Content="协议" VerticalAlignment="Center" Margin="10,0,0,0" />
                <ComboBox Grid.Column="3" x:Name="ProtocolComboBox"
                          ItemsSource="{Binding ProtocolFilterOptions}"
                          SelectedIndex="{Binding SelectedFilterIndex}"
                          IsEditable="False"
                          Height="26" />

                <Button Grid.Column="4" Content="检查端口"
                        Command="{Binding CheckPortCommand}"
                        Style="{StaticResource NormalButtonStyle}"
                        Margin="10,0,0,0" />

                <Button Grid.Column="5" Content="刷新"
                        Command="{Binding CheckPortCommand}"
                        Style="{StaticResource NormalButtonStyle}"
                        Margin="6,0,0,0" />

                <Button Grid.Column="6" Content="清空结果"
                        Command="{Binding ClearResultsCommand}"
                        Style="{StaticResource NormalButtonStyle}"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>

        <!-- ═══ Options ═══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <CheckBox Content="自动刷新 (2秒)"
                      IsChecked="{Binding IsAutoRefresh}"
                      VerticalAlignment="Center" />
            <CheckBox Content="显示命令行"
                      IsChecked="{Binding ShowCmdLine}"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0" />
        </StackPanel>

        <!-- ═══ DataGrid ═══ -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Connections}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  Margin="0,0,0,6"
                  x:Name="ConnectionsGrid"
                  SelectionChanged="ConnectionsGrid_SelectionChanged">

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="MinHeight" Value="24" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Width="70"
                                    Binding="{Binding Pid}" />
                <DataGridTextColumn Header="进程" Width="150"
                                    Binding="{Binding ProcessName}" />
                <DataGridTextColumn Header="协议" Width="60"
                                    Binding="{Binding ProtocolName}" />
                <DataGridTextColumn Header="本地地址" Width="*"
                                    Binding="{Binding LocalAddress}" />
                <DataGridTextColumn Header="远端地址" Width="180"
                                    Binding="{Binding DisplayRemoteAddress, Converter={StaticResource EmptyStringConverter}}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Detail Frame ═══ -->
        <GroupBox Grid.Row="4" Header="命令行详情" Padding="6" Margin="0,0,0,6">
            <TextBox Text="{Binding DetailText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="40"
                     MaxHeight="80"
                     Background="#F5F5F5"
                     BorderThickness="0" />
        </GroupBox>

        <!-- ═══ Action Buttons ═══ -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="结束进程"
                    Command="{Binding KillProcessCommand}"
                    Style="{StaticResource DangerButtonStyle}" />
            <Button Content="复制 PID"
                    Command="{Binding CopyPidCommand}"
                    Style="{StaticResource NormalButtonStyle}"
                    Margin="8,0,0,0" />
            <Button Content="复制命令行"
                    Command="{Binding CopyCmdLineCommand}"
                    Style="{StaticResource NormalButtonStyle}"
                    Margin="8,0,0,0" />
        </StackPanel>

        <!-- ═══ Status Bar ═══ -->
        <StatusBar Grid.Row="6" Background="#E8E8E8" Padding="6,3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>